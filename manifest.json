{
  "schemaVersion": 1,
  "id": "io.github.ol4vr.keychron-profiles",
  "name": "Keychron Profiles",
  "version": "0.2.0-candidate.1",
  "author": "ol4vr",
  "license": "MIT",
  "description": "Hardware-backed Gamepad Mode toggle for Hugin's supported wired Keychron HE keyboards.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Indicators.qml"
  },
  "barWidget": {
    "displayName": "Keychron Profiles",
    "description": "Indicators clone with a Keychron HE Gamepad Mode toggle",
    "category": "Status",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {},
    "schema": [
      {
        "key": "items",
        "type": "multiselect",
        "label": "Indicators",
        "description": "Choose the standard indicators shown alongside the mandatory Gamepad Mode toggle.",
        "noSelectionText": "All indicators",
        "placeholderText": "Search indicators...",
        "emptyText": "No indicators",
        "options": [
          {
            "value": "Dictation",
            "label": "Dictation",
            "description": "Voice typing status"
          },
          {
            "value": "PttMode",
            "label": "Discord PTT",
            "description": "Discord push-to-talk mode"
          },
          {
            "value": "ScreenRecording",
            "label": "Screen recording",
            "description": "GPU screen recorder status"
          },
          {
            "value": "Reminder",
            "label": "Reminder",
            "description": "Queued reminder status"
          },
          {
            "value": "NightLight",
            "label": "Night light",
            "description": "Blue-light filter"
          },
          {
            "value": "Dnd",
            "label": "Do not disturb",
            "description": "Notification silencing"
          },
          {
            "value": "StayAwake",
            "label": "Stay awake",
            "description": "Idle lock and screensaver override"
          },
          {
            "value": "GamepadMode",
            "label": "Gamepad Mode",
            "description": "Connected wired Keychron HE hardware profile"
          }
        ]
      },
      {
        "key": "alwaysShow",
        "type": "boolean",
        "label": "Always Show",
        "description": "Show inactive indicators without waiting for hover.",
        "defaultValue": false
      }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.indicators"
  }
}
